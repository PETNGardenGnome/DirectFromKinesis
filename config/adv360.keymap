#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE    0
#define KEYPAD  1
#define NAV     2
#define MOD     3
#define GAMING  4
#define TT_BASE   200
#define TT_ALT    250
#define TT_PASTE  425
#define QT        175
#define MEH LS(LC(LALT))

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TT_BASE>;
            quick-tap-ms = <QT>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hma: homerow_mods_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TT_ALT>;
            quick-tap-ms = <QT>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hcp: clipboard_holds {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TT_BASE>;
            quick-tap-ms = <QT>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hcv: clipboard_paste {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TT_PASTE>;
            quick-tap-ms = <QT>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        ltg: layer_tap_gate {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TT_BASE>;
            quick-tap-ms = <QT>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp EQUAL            &kp N1        &kp N2           &kp N3        &kp N4        &kp N5     &kp LS(LA(LC(F22)))                                                              &mo 3          &kp N6     &kp N7      &kp N8       &kp N9       &kp N0          &kp MINUS
&kp TAB              &kp Q         &kp W            &kp E         &kp R         &ltg 1 T   &kp C_VOL_UP                                                                     &kp LC(LS(M))  &ltg 2 Y   &kp U       &kp I        &kp O        &kp P           &kp BSLH
&kp ESC              &hm LSHFT A   &hma LALT S      &hm LCTRL D   &hm LGUI F    &hm MEH G  &kp C_VOL_DN         &kp HOME      &kp END         &kp PAGE_UP  &kp PAGE_DOWN    &kp K_MUTE     &hm MEH H  &hm RGUI J  &hm RCTRL K  &hma RALT L  &hm RSHFT SEMI  &kp SQT
&kp LG(PRINTSCREEN)  &hcp LC(Z) Z  &hcp LC(X) X     &hcp LC(C) C  &hcv LC(V) V  &kp B                                         &to 2           &to 1                                        &kp N      &kp M       &kp COMMA    &kp DOT      &kp FSLH        &bl BL_TOG
&none                &kp GRAVE     &kp PRINTSCREEN  &kp LEFT      &kp RIGHT                &lt 1 SPACE          &lt 2 DELETE  &kp ESCAPE      &kp TAB      &lt 2 BACKSPACE  &lt 1 ENTER               &kp UP      &kp DOWN     &kp LBKT     &kp RBKT        &none
            >;
        };

        nav-fn {
            display-name = "nav-fn";
            bindings = <
&kp F1  &kp F2  &kp F3    &kp F4        &kp F5     &kp F6  &tog 2                                  &mo 3  &kp F7  &kp F8          &kp F9          &kp F10          &kp F11  &kp F12
&none   &none   &none     &kp UP_ARROW  &none      &none   &none                                   &none  &none   &mkp MB1        &mmv MOVE_UP    &mkp MB2         &none    &none
&none   &none   &kp LEFT  &kp DOWN      &kp RIGHT  &none   &none   &none  &none      &none  &to 0  &none  &none   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none    &none
&none   &none   &none     &none         &none      &none                  &none      &none                &none   &mkp MB4        &mkp MB3        &mkp MB5         &none    &none
&none   &none   &none     &none         &none              &none   &none  &none      &none  &none  &none          &msc SCRL_UP    &msc SCRL_DOWN  &none            &none    &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none    &none  &none           &none           &none            &none  &none                                                   &mo 3          &none  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB  &none  &none           &kp UP_ARROW    &none            &none  &none                                                   &none          &none  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&none    &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none  &none      &none    &none         &none      &to 0      &none          &none  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&none    &none  &none           &none           &none            &none                      &kp HOME      &kp PG_UP                            &none  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&to 0    &none  &none           &kp LEFT        &kp RIGHT               &kp SPACE  &kp DEL  &kp END       &kp PG_DN  &kp ENTER  &kp BACKSPACE         &gresc      &kp KP_N0     &kp KP_DOT     &kp RBKT         &to 0
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &to 0       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};

&lt {
    quick-tap-ms = <175>;
    flavor = "tap-preferred";
};
