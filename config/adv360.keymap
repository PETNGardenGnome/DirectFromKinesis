#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        primary {
            display-name = "Base";
            bindings = <
&kp EQUAL     &kp N1            &kp N2           &kp N3              &kp N4          &kp N5  &kp LS(LA(LC(F22)))                                                                   &mo 3          &kp N6  &kp N7           &kp N8               &kp N9           &kp N0                     &kp MINUS
&kp TAB       &kp Q             &kp W            &kp E               &kp R           &kp T   &kp C_VOL_UP                                                                          &kp LC(LS(M))  &kp Y   &kp U            &kp I                &kp O            &kp P                      &kp BSLH
&kp ESC       &hm LEFT_SHIFT A  &hm LEFT_ALT S   &hm LEFT_CONTROL D  &hm LEFT_GUI F  &kp G   &kp C_VOL_DN         &kp K_PREV    &kp K_NEXT      &kp K_PLAY_PAUSE  &tog 1           &kp K_MUTE     &kp H   &hm RIGHT_GUI J  &hm RIGHT_CONTROL K  &hm RIGHT_ALT L  &hm RIGHT_SHIFT SEMICOLON  &kp SQT
&kp LG(LEFT)  &kp Z             &kp X            &kp C               &kp V           &kp B                                      &kp HOME        &kp PG_UP                                         &kp N   &kp M            &kp COMMA            &kp DOT          &kp FSLH                   &kp RG(RIGHT)
&mo 2         &kp GRAVE         &kp PRINTSCREEN  &kp LEFT            &kp RIGHT               &lt 2 SPACE          &lt 1 DELETE  &kp END         &kp PG_DN         &lt 1 BACKSPACE  &lt 2 ENTER            &kp UP           &kp DOWN             &kp LBKT         &kp RBKT                   &tog 1
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none    &none  &none           &none           &none            &none  &none                                                   &mo 3      &none  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB  &none  &none           &kp UP_ARROW    &none            &none  &none                                                   &none      &none  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&none    &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none  &none      &none    &none         &none      &tog 0     &none      &none  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&none    &none  &none           &none           &none            &none                      &kp HOME      &kp PG_UP                        &none  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&tog 2   &none  &none           &kp LEFT        &kp RIGHT               &kp SPACE  &kp DEL  &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0         &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &tog 2
            >;
        };

        nav-fn {
            display-name = "nav-fn";
            bindings = <
&kp F1  &kp F2  &kp F3             &kp F4             &kp F5            &kp F6  &tog 1                                   &mo 3  &kp F7  &kp F8          &kp F9          &kp F10          &kp F11  &kp F12
&none   &none   &none              &kp UP_ARROW       &none             &none   &none                                    &none  &none   &mkp MB1        &mmv MOVE_UP    &mkp MB2         &none    &none
&none   &none   &kp LEFT           &kp DOWN           &kp RIGHT         &none   &none   &none  &none      &none  &tog 0  &none  &none   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none    &none
&none   &none   &none              &mmv MOVE_Y(100)   &none             &none                  &none      &none                 &none   &mkp MB4        &mkp MB3        &mkp MB5         &none    &none
&none   &none   &mmv MOVE_X(-100)  &mmv MOVE_Y(-100)  &mmv MOVE_X(100)          &none   &none  &none      &none  &none   &none          &msc SCRL_UP    &msc SCRL_DOWN  &none            &none    &none
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &tog 0      &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
